          "phase": "计划优化", "duration_min": 10,
          "activities": ["检查计划合理性", "与教师共同修订"]
        },
        {
          "phase": "收尾", "duration_min": 5,
          "activities": ["计划承诺确认", "下次会话约定"]
        }
      ],
      "skill_interface": "colleague-skills/flywheel-sops/sop-fw1.skill.md",
      "success_criteria": "周计划完成率 ≥ 80%; 计划与执行偏差 < 20%"
